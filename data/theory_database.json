  "sections": [
    {
      "id": "sec-1",
      "num": 1,
      "title": "Propositional logic",
      "description": "Classical propositional calculus axioms A01–A12 and Modus Ponens inference rule.",
      "entries": [
        {
          "id": "item-1-01",
          "num": "1.01",
          "type": "Axm.",
          "classification": "Axiom",
          "title": "A01 (Affirmation of Consequent)",
          "semantic": "(α → (β → α))",
          "semantic_latex": "(\\alpha \\to (\\beta \\to \\alpha))",
          "syntax": "α, β : Bool",
          "syntax_latex": "\\alpha, \\beta : \\mathsf{Bool}",
          "syntax_link": null,
          "status": "Verified",
          "notes": "Positive implicative axiom."
        },
        {
          "id": "item-1-02",
          "num": "1.02",
          "type": "Axm.",
          "classification": "Axiom",
          "title": "A02 (Distribution of Implication)",
          "semantic": "((α → (β → γ)) → ((α → β) → (α → γ)))",
          "semantic_latex": "((\\alpha \\to (\\beta \\to \\gamma)) \\to ((\\alpha \\to \\beta) \\to (\\alpha \\to \\gamma)))",
          "syntax": "α, β, γ : Bool",
          "syntax_latex": "\\alpha, \\beta, \\gamma : \\mathsf{Bool}",
          "syntax_link": null,
          "status": "Verified",
          "notes": "Self-distribution of implication."
        },
        {
          "id": "item-1-03",
          "num": "1.03",
          "type": "Axm.",
          "classification": "Axiom",
          "title": "A03 (Conjunction Elimination Left)",
          "semantic": "((α ∧ β) → α)",
          "semantic_latex": "((\\alpha \\land \\beta) \\to \\alpha)",
          "syntax": "α, β : Bool",
          "syntax_latex": "\\alpha, \\beta : \\mathsf{Bool}",
          "syntax_link": null,
          "status": "Verified",
          "notes": "Left projection."
        },
        {
          "id": "item-1-04",
          "num": "1.04",
          "type": "Axm.",
          "classification": "Axiom",
          "title": "A04 (Conjunction Elimination Right)",
          "semantic": "((α ∧ β) → β)",
          "semantic_latex": "((\\alpha \\land \\beta) \\to \\beta)",
          "syntax": "α, β : Bool",
          "syntax_latex": "\\alpha, \\beta : \\mathsf{Bool}",
          "syntax_link": null,
          "status": "Verified",
          "notes": "Right projection."
        },
        {
          "id": "item-1-05",
          "num": "1.05",
          "type": "Axm.",
          "classification": "Axiom",
          "title": "A05 (Conjunction Introduction)",
          "semantic": "(α → (β → (α ∧ β)))",
          "semantic_latex": "(\\alpha \\to (\\beta \\to (\\alpha \\land \\beta)))",
          "syntax": "α, β : Bool",
          "syntax_latex": "\\alpha, \\beta : \\mathsf{Bool}",
          "syntax_link": null,
          "status": "Verified",
          "notes": "Pairing of propositional truths."
        },
        {
          "id": "item-1-06",
          "num": "1.06",
          "type": "Axm.",
          "classification": "Axiom",
          "title": "A06 (Disjunction Introduction Left)",
          "semantic": "(α → (α ∨ β))",
          "semantic_latex": "(\\alpha \\to (\\alpha \\lor \\beta))",
          "syntax": "α, β : Bool",
          "syntax_latex": "\\alpha, \\beta : \\mathsf{Bool}",
          "syntax_link": null,
          "status": "Verified",
          "notes": "Left injection."
        },
        {
          "id": "item-1-07",
          "num": "1.07",
          "type": "Axm.",
          "classification": "Axiom",
          "title": "A07 (Disjunction Introduction Right)",
          "semantic": "(β → (α ∨ β))",
          "semantic_latex": "(\\beta \\to (\\alpha \\lor \\beta))",
          "syntax": "α, β : Bool",
          "syntax_latex": "\\alpha, \\beta : \\mathsf{Bool}",
          "syntax_link": null,
          "status": "Verified",
          "notes": "Right injection."
        },
        {
          "id": "item-1-08",
          "num": "1.08",
          "type": "Axm.",
          "classification": "Axiom",
          "title": "A08 (Disjunction Elimination / Cases)",
          "semantic": "((α → γ) → ((β → γ) → ((α ∨ β) → γ)))",
          "semantic_latex": "((\\alpha \\to \\gamma) \\to ((\\beta \\to \\gamma) \\to ((\\alpha \\lor \\beta) \\to \\gamma)))",
          "syntax": "α, β, γ : Bool",
          "syntax_latex": "\\alpha, \\beta, \\gamma : \\mathsf{Bool}",
          "syntax_link": null,
          "status": "Verified",
          "notes": "Proof by cases."
        },
        {
          "id": "item-1-09",
          "num": "1.09",
          "type": "Axm.",
          "classification": "Axiom",
          "title": "A09 (Negation Introduction / Contradiction)",
          "semantic": "((¬α) → (α → ⊥))",
          "semantic_latex": "((\\neg \\alpha) \\to (\\alpha \\to \\bot))",
          "syntax": "α : Bool",
          "syntax_latex": "\\alpha : \\mathsf{Bool}",
          "syntax_link": null,
          "status": "Verified",
          "notes": "Contradiction to bottom."
        },
        {
          "id": "item-1-10",
          "num": "1.10",
          "type": "Axm.",
          "classification": "Axiom",
          "title": "A10 (Reductio Ad Absurdum)",
          "semantic": "((α → β) → ((α → ¬β) → ¬α))",
          "semantic_latex": "((\\alpha \\to \\beta) \\to ((\\alpha \\to \\neg \\beta) \\to \\neg \\alpha))",
          "syntax": "α, β : Bool",
          "syntax_latex": "\\alpha, \\beta : \\mathsf{Bool}",
          "syntax_link": null,
          "status": "Verified",
          "notes": "Proof of negation."
        },
        {
          "id": "item-1-11",
          "num": "1.11",
          "type": "Axm.",
          "classification": "Axiom",
          "title": "A11 (Ex Falso Quodlibet)",
          "semantic": "(⊥ → α)",
          "semantic_latex": "(\\bot \\to \\alpha)",
          "syntax": "α : Bool",
          "syntax_latex": "\\alpha : \\mathsf{Bool}",
          "syntax_link": null,
          "status": "Verified",
          "notes": "Principle of explosion."
        },
        {
          "id": "item-1-12",
          "num": "1.12",
          "type": "Axm.",
          "classification": "Axiom",
          "title": "A12 (Law of Excluded Middle)",
          "semantic": "(α ∨ ¬α)",
          "semantic_latex": "(\\alpha \\lor \\neg \\alpha)",
          "syntax": "α : Bool",
          "syntax_latex": "\\alpha : \\mathsf{Bool}",
          "syntax_link": null,
          "status": "Verified",
          "notes": "Classical tertium non datur."
        },
        {
          "id": "rule-mp",
          "num": "1.13",
          "type": "Rule",
          "classification": "Inference Rule",
          "title": "Modus Ponens (MP)",
          "semantic": "α, (α → β) ⊢ β",
          "semantic_latex": "\\frac{\\alpha \\quad \\alpha \\to \\beta}{\\beta}",
          "syntax": "α, β : Bool",
          "syntax_latex": "\\alpha, \\beta : \\mathsf{Bool}",
          "syntax_link": null,
          "status": "Verified",
          "notes": "Fundamental detachment rule."
        }
      ]
    },
    {
      "id": "sec-2",
      "num": 2,
      "title": "Predicate logic",
      "description": "First-order predicate calculus with typed domain, Bernays rules, substitution, and eigenvariable conditions.",
      "entries": [
        {
          "id": "item-2-01",
          "num": "2.01",
          "type": "Axm.",
          "classification": "Axiom",
          "title": "Discourse domain is non-empty",
          "semantic": "∃(K : Class) ⊤",
          "semantic_latex": "\\exists (K : \\mathsf{Class})\\; \\top",
          "syntax": "K : Class",
          "syntax_latex": "K : \\mathsf{Class}",
          "syntax_link": null,
          "status": "Verified",
          "notes": "Ensures the universe of discourse contains at least one class."
        },
        {
          "id": "rule-fi",
          "num": "2.02",
          "type": "Rule",
          "classification": "Inference Rule",
          "title": "Forall Instantiation (FI)",
          "semantic": "(∀(x : Class) φ) → φ[t/x]",
          "semantic_latex": "((\\forall (x : \\mathsf{Class})\\; \\phi) \\to \\phi[t/x])",
          "syntax": "FFI(t, v_x, φ) : Bool",
          "syntax_latex": "\\mathrm{FFI}(t, v_x, \\phi) : \\mathsf{Bool}",
          "syntax_link": "metatheory.html#ffi-t-vx-phi",
          "status": "Verified",
          "notes": "Term t is free for substitution for variable identifier v_x in formula φ."
        },
        {
          "id": "rule-ei",
          "num": "2.03",
          "type": "Rule",
          "classification": "Inference Rule",
          "title": "Exists Instantiation (EI)",
          "semantic": "φ[t/x] → ∃(x : Class) φ",
          "semantic_latex": "(\\phi[t/x] \\to \\exists (x : \\mathsf{Class})\\; \\phi)",
          "syntax": "FFI(t, v_x, φ) : Bool",
          "syntax_latex": "\\mathrm{FFI}(t, v_x, \\phi) : \\mathsf{Bool}",
          "syntax_link": "metatheory.html#ffi-t-vx-phi",
          "status": "Verified",
          "notes": "Witness substitution into existential quantifier."
        },
        {
          "id": "rule-fa",
          "num": "2.04",
          "type": "Rule",
          "classification": "Inference Rule",
          "title": "Forall Abstraction (FA / Bernays)",
          "semantic": "(ψ → φ) ⊢ (ψ → ∀(x : Class) φ)",
          "semantic_latex": "\\frac{\\psi \\to \\phi}{\\psi \\to \\forall (x : \\mathsf{Class})\\; \\phi}",
          "syntax": "NFV(v_x, ψ) : Bool ∧ NFV(v_x, Γ) : Bool",
          "syntax_latex": "\\mathrm{NFV}(v_x, \\psi) : \\mathsf{Bool} \\land \\mathrm{NFV}(v_x, \\Gamma) : \\mathsf{Bool}",
          "syntax_link": "metatheory.html#nfv-vx-psi",
          "status": "Verified",
          "notes": "Eigenvariable condition: variable identifier v_x does not occur free in antecedent ψ or context Γ."
        },
        {
          "id": "rule-ea",
          "num": "2.05",
          "type": "Rule",
          "classification": "Inference Rule",
          "title": "Exists Abstraction (EA / Bernays)",
          "semantic": "(φ → ψ) ⊢ (∃(x : Class) φ → ψ)",
          "semantic_latex": "\\frac{\\phi \\to \\psi}{\\exists (x : \\mathsf{Class})\\; \\phi \\to \\psi}",
          "syntax": "NFV(v_x, ψ) : Bool ∧ NFV(v_x, Γ) : Bool",
          "syntax_latex": "\\mathrm{NFV}(v_x, \\psi) : \\mathsf{Bool} \\land \\mathrm{NFV}(v_x, \\Gamma) : \\mathsf{Bool}",
          "syntax_link": "metatheory.html#nfv-vx-psi",
          "status": "Verified",
          "notes": "Dual eigenvariable condition: v_x not free in consequent ψ or assumptions."
        },
        {
          "id": "rule-gen",
          "num": "2.06",
          "type": "Rule",
          "classification": "Inference Rule",
          "title": "Generalisation (Gen)",
          "semantic": "φ ⊢ ∀(x : Class) φ",
          "semantic_latex": "\\frac{\\phi}{\\forall (x : \\mathsf{Class})\\; \\phi}",
          "syntax": "NFV(v_x, Γ) : Bool",
          "syntax_latex": "\\mathrm{NFV}(v_x, \\Gamma) : \\mathsf{Bool}",
          "syntax_link": "metatheory.html#nfv-vx-gamma",
          "status": "Verified",
          "notes": "Universal generalization over variable identifier v_x not free in active context Γ."
        }
      ]
    },
    {
      "id": "sec-3",
      "num": 3,
      "title": "Set/class-theoretic foundations of mathematics",
      "description": "Morse–Kelley (MK) axiomatic class theory with Dunaev tagged ordered pairs, class comprehension, class conditional if-then-else, simple_if, dependent_if, and Ordinal Induction.",
      "entries": [
        {
          "id": "item-3-01",
          "num": "3.01",
          "type": "Axm.",
          "classification": "Axiom Schema",
          "title": "Class Comprehension Axiom Schema",
          "semantic": "∀(X : Class) (X ∈ {x | φ(x)} ⟷ (isSet(X) ∧ φ(X)))",
          "semantic_latex": "\\forall (X : \\mathsf{Class})\\; (X \\in \\{x \\mid \\phi(x)\\} \\longleftrightarrow (\\mathrm{isSet}(X) \\land \\phi(X)))",
          "syntax": "NFV(v_C, φ) : Bool",
          "syntax_latex": "\\mathrm{NFV}(v_C, \\phi) : \\mathsf{Bool}",
          "syntax_link": "metatheory.html#nfv-c-phi",
          "status": "Verified",
          "notes": "Predicative/impredicative comprehension for all first-order and higher-order formulas."
        },
        {
          "id": "item-3-02",
          "num": "3.02",
          "type": "Axm.",
          "classification": "Axiom",
          "title": "Extensionality Axiom",
          "semantic": "∀(A, B : Class) ((∀(x : Class) (x ∈ A ⟷ x ∈ B)) → A = B)",
          "semantic_latex": "\\forall (A, B : \\mathsf{Class})\\; ((\\forall (x : \\mathsf{Class})\\; (x \\in A \\longleftrightarrow x \\in B)) \\to A = B)",
          "syntax": "A, B, x : Class",
          "syntax_latex": "A, B, x : \\mathsf{Class}",
          "syntax_link": null,
          "status": "Verified",
          "notes": "Two classes having identical elements are identical."
        },
        {
          "id": "item-3-08",
          "num": "3.08",
          "type": "Axm.",
          "classification": "Axiom",
          "title": "Heredity Axiom (Subclasses of Sets are Sets)",
          "semantic": "∀(A, B : Class) ((isSet(B) ∧ A ⊆ B) → isSet(A))",
          "semantic_latex": "\\forall (A, B : \\mathsf{Class})\\; ((\\mathrm{isSet}(B) \\land A \\subseteq B) \\to \\mathrm{isSet}(A))",
          "syntax": "A, B : Class",
          "syntax_latex": "A, B : \\mathsf{Class}",
          "syntax_link": null,
          "status": "Verified",
          "notes": "Any subclass of a set is a set."
        },
        {
          "id": "item-3-12",
          "num": "3.12",
          "type": "Axm.",
          "classification": "Axiom",
          "title": "Regularity (Foundation) Axiom",
          "semantic": "∀(A : Class) (A ≠ ∅ → ∃(x : Class) (x ∈ A ∧ x ∩ A = ∅))",
          "semantic_latex": "\\forall (A : \\mathsf{Class})\\; (A \\ne \\emptyset \\to \\exists (x : \\mathsf{Class})\\; (x \\in A \\land x \\cap A = \\emptyset))",
          "syntax": "A, x : Class",
          "syntax_latex": "A, x : \\mathsf{Class}",
          "syntax_link": null,
          "status": "Verified",
          "notes": "Every non-empty class contains an ∈-minimal element. Rules out infinite descending ∈-chains."
        },
        {
          "id": "item-3-13",
          "num": "3.13",
          "type": "Axm.",
          "classification": "Axiom",
          "title": "Pairing Axiom",
          "semantic": "∀(a, b : Class) ((isSet(a) ∧ isSet(b)) → isSet({a, b}))",
          "semantic_latex": "\\forall (a, b : \\mathsf{Class})\\; ((\\mathrm{isSet}(a) \\land \\mathrm{isSet}(b)) \\to \\mathrm{isSet}(\\{a, b\\}))",
          "syntax": "a, b : Class",
          "syntax_latex": "a, b : \\mathsf{Class}",
          "syntax_link": null,
          "status": "Verified",
          "notes": "Unordered pair of two sets is a set."
        },
        {
          "id": "item-3-14",
          "num": "3.14",
          "type": "Axm.",
          "classification": "Axiom",
          "title": "Union Axiom",
          "semantic": "∀(A : Class) (isSet(A) → isSet(⋃ A))",
          "semantic_latex": "\\forall (A : \\mathsf{Class})\\; (\\mathrm{isSet}(A) \\to \\mathrm{isSet}(\\bigcup A))",
          "syntax": "A : Class",
          "syntax_latex": "A : \\mathsf{Class}",
          "syntax_link": null,
          "status": "Verified",
          "notes": "The unary union of any set is a set."
        },
        {
          "id": "item-3-22-class-if",
          "num": "3.22",
          "type": "Def.",
          "classification": "Definition",
          "title": "IF-THEN-ELSE-FI (Class conditional with NFV side condition and context turnstile)",
          "semantic": "W, Γ ⊢ (IF ψ THEN A ELSE B FI) = { v | (ψ ∧ v ∈ A) ∨ (¬ψ ∧ v ∈ B) }",
          "semantic_latex": "\\mathcal{W}, \\Gamma \\vdash (\\mathrm{IF}\\; \\psi\\; \\mathrm{THEN}\\; A\\; \\mathrm{ELSE}\\; B\\; \\mathrm{FI}) = \\{ v \\mid (\\psi \\land v \\in A) \\lor (\\neg\\psi \\land v \\in B) \\}",
          "syntax": "NFV(v_v, ψ) : Bool ∧ NFV(v_v, Γ) : Bool",
          "syntax_latex": "\\mathrm{NFV}(v_v, \\psi) : \\mathsf{Bool} \\land \\mathrm{NFV}(v_v, \\Gamma) : \\mathsf{Bool}",
          "syntax_link": "metatheory.html#nfv-vv-psi",
          "status": "Verified",
          "notes": "Class-level conditional defined via class comprehension. Soundness requires variable identifier v_v not free in formula ψ or context Γ."
        },
        {
          "id": "item-3-23-simple-if",
          "num": "3.23",
          "type": "Def.",
          "classification": "Definition",
          "title": "simple_if (polymorphic non-dependent conditional over arbitrary Type)",
          "semantic": "simple_if : ∏(α : Type). Bool → α → α → α   (simple_if α true t1 t2 = t1, simple_if α false t1 t2 = t2)",
          "semantic_latex": "\\mathrm{simple\\_if} : \\Pi (\\alpha : \\mathsf{Type}).\\; \\mathsf{Bool} \\to \\alpha \\to \\alpha \\to \\alpha \\quad (\\mathrm{simple\\_if}\\;\\alpha\\;\\mathrm{true}\\;t_1\\;t_2 = t_1, \\; \\mathrm{simple\\_if}\\;\\alpha\\;\\mathrm{false}\\;t_1\\;t_2 = t_2)",
          "syntax": "α : Type, t1, t2 : α",
          "syntax_latex": "\\alpha : \\mathsf{Type}, \\quad t_1, t_2 : \\alpha",
          "syntax_link": "metatheory.html#simple-if-typing",
          "status": "Verified",
          "notes": "Non-dependent type-theoretic conditional working parametrically over any metatype, not restricted to Class."
        },
        {
          "id": "item-3-24-dependent-if",
          "num": "3.24",
          "type": "Def.",
          "classification": "Definition",
          "title": "dependent_if (polymorphic dependent conditional with type computation)",
          "semantic": "dependent_if : ∏(T : Bool → Type) (b : Bool). T(true) → T(false) → T(b)   (typeof(if b then t1 else t2) := simple_if Type b (typeof t1) (typeof t2))",
          "semantic_latex": "\\mathrm{dependent\\_if} : \\Pi (T : \\mathsf{Bool} \\to \\mathsf{Type}) (b : \\mathsf{Bool}).\\; T(\\mathrm{true}) \\to T(\\mathrm{false}) \\to T(b) \\quad (\\mathrm{typeof}(\\mathrm{if}\\; b\\; \\mathrm{then}\\; t_1\\; \\mathrm{else}\\; t_2) := \\mathrm{simple\\_if}\\;\\mathsf{Type}\\;b\\;(\\mathrm{typeof}\\;t_1)\\;(\\mathrm{typeof}\\;t_2))",
          "syntax": "T : Bool → Type, t1 : T(true), t2 : T(false)",
          "syntax_latex": "T : \\mathsf{Bool} \\to \\mathsf{Type}, \\quad t_1 : T(\\mathrm{true}), \\; t_2 : T(\\mathrm{false})",
          "syntax_link": "metatheory.html#dependent-if-typing",
          "status": "Verified",
          "notes": "Dependent type-theoretic conditional computing branch types dynamically using simple_if at the universe of Types."
        },
        {
          "id": "thm-ord-ind",
          "num": "3.32",
          "type": "Thm.",
          "classification": "Theorem Schema",
          "title": "Ordinal Induction (∈-Ind) Theorem Schema",
          "semantic": "(∀(α : Class) (α ∈ On → (∀(β : Class) (β ∈ α → φ(β)) → φ(α)))) → ∀(α : Class) (α ∈ On → φ(α))",
          "semantic_latex": "((\\forall (\\alpha : \\mathsf{Class})\\; (\\alpha \\in \\mathrm{On} \\to ((\\forall (\\beta : \\mathsf{Class})\\; (\\beta \\in \\alpha \\to \\phi(\\beta))) \\to \\phi(\\alpha)))) \\to \\forall (\\alpha : \\mathsf{Class})\\; (\\alpha \\in \\mathrm{On} \\to \\phi(\\alpha)))",
          "syntax": "On : Class, WF(∈, On) : Bool",
          "syntax_latex": "\\mathrm{On} : \\mathsf{Class}, \\quad \\mathrm{WF}(\\in, \\mathrm{On}) : \\mathsf{Bool}",
          "syntax_link": "metatheory.html#ord-induction",
          "status": "Verified",
          "program": "let rec ord_ind (p : Prog) (a : Class) : Prf = ...",
          "notes": "On is a Class object, not a syntactic type. This is a Theorem Schema inhabited by a constructive proof program."
        },
        {
          "id": "item-3-34",
          "num": "3.34",
          "type": "Axm.",
          "classification": "Axiom",
          "title": "Power Class Axiom",
          "semantic": "∀(a : Class) (isSet(a) → isSet(𝒫(a)))",
          "semantic_latex": "\\forall (a : \\mathsf{Class})\\; (\\mathrm{isSet}(a) \\to \\mathrm{isSet}(\\mathcal{P}(a)))",
          "syntax": "a : Class",
          "syntax_latex": "a : \\mathsf{Class}",
          "syntax_link": null,
          "status": "Verified",
          "notes": "Power class of any set is a set."
        },
        {
          "id": "item-3-37",
          "num": "3.37",
          "type": "Axm.",
          "classification": "Axiom Schema",
          "title": "Replacement / Limitation of Size Axiom Schema",
          "semantic": "∀(F, A : Class) ((isClassFunction(F) ∧ isSet(A)) → isSet(F[A]))",
          "semantic_latex": "\\forall (F, A : \\mathsf{Class})\\; ((\\mathrm{isClassFunction}(F) \\land \\mathrm{isSet}(A)) \\to \\mathrm{isSet}(F[A]))",
          "syntax": "F, A : Class",
          "syntax_latex": "F, A : \\mathsf{Class}",
          "syntax_link": null,
          "status": "Verified",
          "notes": "Image of a set under a class function is a set."
        },
        {
          "id": "item-3-45",
          "num": "3.45",
          "type": "Axm.",
          "classification": "Axiom",
          "title": "Infinity Axiom",
          "semantic": "∃(x : Class) (isSet(x) ∧ ∅ ∈ x ∧ ∀(y : Class) (y ∈ x → y ∪ {y} ∈ x))",
          "semantic_latex": "\\exists (x : \\mathsf{Class})\\; (\\mathrm{isSet}(x) \\land \\emptyset \\in x \\land \\forall (y : \\mathsf{Class})\\; (y \\in x \\to y \\cup \\{y\\} \\in x))",
          "syntax": "x, y : Class",
          "syntax_latex": "x, y : \\mathsf{Class}",
          "syntax_link": null,
          "status": "Verified",
          "notes": "Guarantees existence of the set of natural numbers ω."
        },
        {
          "id": "item-3-46",
          "num": "3.46",
          "type": "Axm.",
          "classification": "Axiom",
          "title": "Global Choice Axiom",
          "semantic": "∃(c : Class) (isClassFunction(c) ∧ ∀(x : Class) ((isSet(x) ∧ x ≠ ∅) → c(x) ∈ x))",
          "semantic_latex": "\\exists (c : \\mathsf{Class})\\; (\\mathrm{isClassFunction}(c) \\land \\forall (x : \\mathsf{Class})\\; ((\\mathrm{isSet}(x) \\land x \\ne \\emptyset) \\to c(x) \\in x))",
          "syntax": "c, x : Class",
          "syntax_latex": "c, x : \\mathsf{Class}",
          "syntax_link": null,
          "status": "Verified",
          "notes": "Global choice function over all non-empty sets."
        },
        {
          "id": "item-3-47",
          "num": "3.47",
          "type": "Def.",
          "classification": "Definition",
          "title": "Universal Class (V)",
          "semantic": "V = {x | x = x}",
          "semantic_latex": "V = \\{x \\mid x = x\\}",
          "syntax": "V : Class",
          "syntax_latex": "V : \\mathsf{Class}",
          "syntax_link": null,
          "status": "Verified",
          "notes": "Universe of all sets. V is a proper class (not a set)."
        },
        {
          "id": "item-3-53",
          "num": "3.53",
          "type": "Def.",
          "classification": "Definition",
          "title": "Transitive Class Predicate",
          "semantic": "Tr(A) ⟷ ∀(x : Class) (x ∈ A → x ⊆ A)",
          "semantic_latex": "\\mathrm{Tr}(A) \\longleftrightarrow \\forall (x : \\mathsf{Class})\\; (x \\in A \\to x \\subseteq A)",
          "syntax": "A, x : Class",
          "syntax_latex": "A, x : \\mathsf{Class}",
          "syntax_link": null,
          "status": "Verified",
          "notes": "A class is transitive if every element of it is also a subclass."
        },
        {
          "id": "item-3-66",
          "num": "3.66",
          "type": "Axm.",
          "classification": "Axiom",
          "title": "Tarski's Axiom of Universes",
          "semantic": "∀(x : Class) (isSet(x) → ∃(u : Class) (isUniverse(u) ∧ x ∈ u ∧ isSet(u)))",
          "semantic_latex": "\\forall (x : \\mathsf{Class})\\; (\\mathrm{isSet}(x) \\to \\exists (u : \\mathsf{Class})\\; (\\mathrm{isUniverse}(u) \\land x \\in u \\land \\mathrm{isSet}(u)))",
          "syntax": "x, u : Class",
          "syntax_latex": "x, u : \\mathsf{Class}",
          "syntax_link": null,
          "status": "Verified",
          "notes": "Grothendieck-Tarski universes: every set belongs to a transitive, power-closed universe."
        }
      ]
    },
