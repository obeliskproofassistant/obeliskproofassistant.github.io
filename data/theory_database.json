          "semantic_latex": "\\forall (\\phi : \\mathsf{Fm})\\; (\\mathcal{T}, [] \\vdash (\\exists! (x : \\mathsf{Class})\\; \\phi) \\longleftrightarrow ((\\exists (x : \\mathsf{Class})\\; \\phi) \\land ! (x : \\mathsf{Class})\\; \\phi))",
