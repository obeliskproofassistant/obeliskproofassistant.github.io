          "semantic_latex": "\\forall (\\phi : \\mathsf{Fm})\\; ((! (z : \\mathsf{Class})\\; \\phi) \\longleftrightarrow \\forall (x, y : \\mathsf{Class})\\; ((\\phi[x/z] \\land \\phi[y/z]) \\to x = y))",
